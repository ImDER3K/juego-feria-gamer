
import processing.event.*;

// ==================================================
// SUPERVIVENCIA DIGITAL
// ==================================================

// ESTADOS

final int MENU = 0;
final int CINEMATICA = 1;
final int EXPLORACION = 2;
final int DIALOGO = 3;
final int MINIJUEGO = 4;
final int PAUSA = 5;
final int FINAL = 6;

int estadoActual = MENU;

// ==================================================
// RECURSOS
// ==================================================

PImage fondoMenu;
PImage mapa;
PImage colisiones;

boolean recursosListos = false;

// ==================================================
// JUGADOR
// ==================================================

float jugadorX;
float jugadorY;

float velocidad = 0;
float velocidadMaxima = 3.0;
float aceleracion = 0.18;
float desaceleracion = 0.22;

float direccionX = 0;
float direccionY = 0;

boolean moviendo = false;

// ==================================================
// CONTROLES WASD
// ==================================================

boolean teclaW = false;
boolean teclaA = false;
boolean teclaS = false;
boolean teclaD = false;

// ==================================================
// CAMARA
// ==================================================

float zoomActual = 1.0;
float zoomInicial = 1.0;
float zoomFinal = 1.5;

int tiempoCinematica;
int duracionCinematica = 2500;

// ==================================================
// PUNTOS DEL MAPA
// ==================================================

float[] puntosX = new float[5];
float[] puntosY = new float[5];

String[] nombresPuntos = {
  "Fuente",
  "Biblioteca",
  "Cafeteria",
  "Salon",
  "Zona deportiva"
};

// ==================================================
// NIEBLA DE GUERRA
// ==================================================

int tamanoCelda = 16;

int columnasNiebla;
int filasNiebla;

boolean[][] mapaDescubierto;

float radioDescubrimiento = 120;

// ==================================================
// VARIABLES GENERALES
// ==================================================

boolean mostrarColisiones = false;

int diaActual = 1;

// ==================================================
// SETUP
// ==================================================

void setup() {

  size(1080, 600, P2D);
  pixelDensity(1);

  surface.setTitle("Supervivencia Digital");

  cargarRecursos();

  if (recursosListos) {

    configurarNiebla();
    configurarPuntos();

    if (!iniciarJugador()) {
      recursosListos = false;
    }
  }
}

// ==================================================
// CARGAR RECURSOS
// ==================================================

void cargarRecursos() {

  fondoMenu = loadImage("menu/fondo_menu.jpg");
  mapa = loadImage("mapas/mapa.png");

  // Mascara de colisiones JPG

  colisiones = loadImage("mapas/colisiones.jpg");

  if (fondoMenu == null) {
    println("ERROR: No se encontro fondo_menu.jpg");
    return;
  }

  if (mapa == null) {
    println("ERROR: No se encontro mapa.png");
    return;
  }

  if (colisiones == null) {
    println("ERROR: No se encontro colisiones.jpg");
    return;
  }

  mapa.loadPixels();
  colisiones.loadPixels();

  println("--------------------------------");
  println("MAPA: " + mapa.width + " x " + mapa.height);
  println("COLISIONES: " + colisiones.width + " x " + colisiones.height);
  println("--------------------------------");

  if (mapa.width != colisiones.width ||
      mapa.height != colisiones.height) {

    println("ERROR: Las dimensiones no coinciden.");
    println("Ambas imagenes deben tener el mismo tamaño.");

    return;
  }

  recursosListos = true;
}

// ==================================================
// CONFIGURAR PUNTOS
// ==================================================

void configurarPuntos() {

  puntosX[0] = mapa.width * 0.50;
  puntosY[0] = mapa.height * 0.30;

  puntosX[1] = mapa.width * 0.25;
  puntosY[1] = mapa.height * 0.45;

  puntosX[2] = mapa.width * 0.70;
  puntosY[2] = mapa.height * 0.45;

  puntosX[3] = mapa.width * 0.45;
  puntosY[3] = mapa.height * 0.70;

  puntosX[4] = mapa.width * 0.75;
  puntosY[4] = mapa.height * 0.75;
}

// ==================================================
// CONFIGURAR NIEBLA
// ==================================================

void configurarNiebla() {

  columnasNiebla = ceil(mapa.width / (float)tamanoCelda);
  filasNiebla = ceil(mapa.height / (float)tamanoCelda);

  mapaDescubierto = new boolean[columnasNiebla][filasNiebla];

  for (int x = 0; x < columnasNiebla; x++) {

    for (int y = 0; y < filasNiebla; y++) {

      mapaDescubierto[x][y] = false;
    }
  }
}

// ==================================================
// DETECTAR VERDE EN JPG
// ==================================================

boolean esPixelVerde(int px, int py) {

  if (px < 0 || py < 0 ||
      px >= colisiones.width ||
      py >= colisiones.height) {

    return false;
  }

  color c = colisiones.pixels[
    py * colisiones.width + px
  ];

  float r = red(c);
  float g = green(c);
  float b = blue(c);

  // Tolerancia para compresion JPG

  return (
    g > 100 &&
    g > r * 1.4 &&
    g > b * 1.4
  );
}

// ==================================================
// COMPROBAR ZONA TRANSITABLE
// ==================================================

boolean esZonaVerde(float x, float y) {

  int px = round(x);
  int py = round(y);

  return esPixelVerde(px, py);
}

// ==================================================
// INICIAR JUGADOR
// ==================================================

boolean iniciarJugador() {

  int mejorX = -1;
  int mejorY = -1;

  float menorDistancia = Float.MAX_VALUE;

  float centroX = mapa.width / 2.0;
  float centroY = mapa.height / 2.0;

  // Buscar zona verde con espacio alrededor

  for (int y = 2; y < colisiones.height - 2; y++) {

    for (int x = 2; x < colisiones.width - 2; x++) {

      if (!esPixelVerde(x, y)) {
        continue;
      }

      boolean espacioValido = true;

      for (int dy = -2; dy <= 2; dy++) {

        for (int dx = -2; dx <= 2; dx++) {

          if (!esPixelVerde(x + dx, y + dy)) {

            espacioValido = false;
            break;
          }
        }

        if (!espacioValido) {
          break;
        }
      }

      if (espacioValido) {

        float distancia = dist(
          centroX,
          centroY,
          x,
          y
        );

        if (distancia < menorDistancia) {

          menorDistancia = distancia;

          mejorX = x;
          mejorY = y;
        }
      }
    }
  }

  if (mejorX == -1) {

    println("ERROR: No se encontro una zona verde.");
    println("Revisa los colores de colisiones.jpg.");

    return false;
  }

  jugadorX = mejorX;
  jugadorY = mejorY;

  velocidad = 0;

  direccionX = 0;
  direccionY = 0;

  moviendo = false;

  println("--------------------------------");
  println("JUGADOR INICIADO");
  println("X: " + jugadorX);
  println("Y: " + jugadorY);
  println("Zona verde: " + esZonaVerde(jugadorX, jugadorY));
  println("--------------------------------");

  actualizarDescubrimiento();

  return true;
}

// ==================================================
// DRAW PRINCIPAL
// ==================================================

void draw() {

  background(20);

  if (!recursosListos) {

    dibujarError();
    return;
  }

  switch(estadoActual) {

  case MENU:

    dibujarMenu();
    break;

  case CINEMATICA:

    dibujarCinematica();
    break;

  case EXPLORACION:

    actualizarExploracion();
    dibujarExploracion();
    break;

  case DIALOGO:

    dibujarExploracion();
    dibujarDialogo();
    break;

  case MINIJUEGO:

    dibujarMinijuego();
    break;

  case PAUSA:

    dibujarExploracion();
    dibujarPausa();
    break;

  case FINAL:

    dibujarFinal();
    break;
  }
}

// ==================================================
// ERROR DE RECURSOS
// ==================================================

void dibujarError() {

  background(30);

  fill(255);
  textAlign(CENTER, CENTER);

  textSize(24);

  text(
    "ERROR AL CARGAR LOS RECURSOS",
    width/2,
    230
  );

  textSize(15);

  text(
    "Revisa la carpeta data y la consola.",
    width/2,
    275
  );

  text(
    "Mapa y colisiones deben tener el mismo tamaño.",
    width/2,
    305
  );
}

// ==================================================
// MENU
// ==================================================

void dibujarMenu() {

  imageMode(CORNER);

  image(
    fondoMenu,
    0,
    0,
    width,
    height
  );

  fill(255);

  textAlign(LEFT, CENTER);

  textSize(40);

  text("SUPERVIVENCIA", 55, 90);
  text("DIGITAL", 55, 135);

  dibujarBoton("JUGAR", 55, 230, 230, 48);
  dibujarBoton("CONTINUAR", 55, 290, 230, 48);
  dibujarBoton("COMO JUGAR", 55, 350, 230, 48);
  dibujarBoton("CREDITOS", 55, 410, 230, 48);
  dibujarBoton("SALIR", 55, 470, 230, 48);
}

// ==================================================
// BOTONES
// ==================================================

void dibujarBoton(
  String texto,
  float x,
  float y,
  float w,
  float h
) {

  boolean encima =
    mouseX >= x &&
    mouseX <= x + w &&
    mouseY >= y &&
    mouseY <= y + h;

  if (encima) {
    fill(80, 220, 140);
  } else {
    fill(35, 35, 45, 230);
  }

  stroke(255);
  strokeWeight(2);

  rect(x, y, w, h, 12);

  noStroke();

  fill(255);

  textAlign(CENTER, CENTER);
  textSize(18);

  text(
    texto,
    x + w/2,
    y + h/2
  );
}

// ==================================================
// CINEMATICA
// ==================================================

void iniciarCinematica() {

  estadoActual = CINEMATICA;

  tiempoCinematica = millis();

  zoomActual = zoomInicial;
}

void dibujarCinematica() {

  float progreso = constrain(
    (millis() - tiempoCinematica) / (float)duracionCinematica,
    0,
    1
  );

  float suavizado = progreso * progreso * (3 - 2 * progreso);

  zoomActual = lerp(
    zoomInicial,
    zoomFinal,
    suavizado
  );

  dibujarMapa();

  fill(255);

  textAlign(CENTER, CENTER);
  textSize(20);

  text(
    "Preparando el campus...",
    width/2,
    height - 45
  );

  if (progreso >= 1) {

    estadoActual = EXPLORACION;

    zoomActual = zoomFinal;
  }
}

// ==================================================
// ACTUALIZAR EXPLORACION
// ==================================================

void actualizarExploracion() {

  moverJugador();

  actualizarDescubrimiento();
}

void dibujarExploracion() {

  dibujarMapa();

  dibujarHUD();

  if (mostrarColisiones) {

    dibujarMascaraDepuracion();
  }
}

// ==================================================
// MOVIMIENTO WASD
// ==================================================

void moverJugador() {

  float objetivoX = 0;
  float objetivoY = 0;

  // DIRECCIONES

  if (teclaW) objetivoY--;
  if (teclaS) objetivoY++;

  if (teclaA) objetivoX--;
  if (teclaD) objetivoX++;

  // NORMALIZAR DIAGONAL

  float magnitud = sqrt(
    objetivoX * objetivoX +
    objetivoY * objetivoY
  );

  if (magnitud > 0) {

    objetivoX /= magnitud;
    objetivoY /= magnitud;

    // Aceleracion progresiva

    velocidad = min(
      velocidad + aceleracion,
      velocidadMaxima
    );

  } else {

    // Desaceleracion progresiva

    velocidad = max(
      velocidad - desaceleracion,
      0
    );
  }

  // Direccion actual

  if (magnitud > 0) {

    direccionX = objetivoX;
    direccionY = objetivoY;
  }

  // Si ya se detuvo, salir

  if (velocidad <= 0.01) {

    velocidad = 0;
    moviendo = false;

    return;
  }

  moviendo = true;

  float movimientoX = direccionX * velocidad;
  float movimientoY = direccionY * velocidad;

  float nuevoX = jugadorX + movimientoX;
  float nuevoY = jugadorY + movimientoY;

  // COLISION HORIZONTAL

  if (esZonaVerde(nuevoX, jugadorY)) {

    jugadorX = nuevoX;
  }

  // COLISION VERTICAL

  if (esZonaVerde(jugadorX, nuevoY)) {

    jugadorY = nuevoY;
  }

}

// ==================================================
// DIBUJAR MAPA Y CAMARA
// ==================================================

void dibujarMapa() {

  pushMatrix();

  translate(width/2, height/2);

  scale(zoomActual);

  imageMode(CORNER);

  image(
    mapa,
    -jugadorX,
    -jugadorY
  );

  dibujarNiebla();

  dibujarPuntos();

  popMatrix();

  dibujarJugador();
}

// ==================================================
// DIBUJAR JUGADOR
// ==================================================

void dibujarJugador() {

  float centroX = width/2;
  float centroY = height/2;

  noStroke();

  // Sombra

  fill(0, 100);

  ellipse(
    centroX,
    centroY + 9,
    25,
    12
  );

  // Cuerpo

  fill(255, 190, 50);

  ellipse(
    centroX,
    centroY,
    25,
    25
  );

  // Centro

  fill(255);

  ellipse(
    centroX,
    centroY,
    9,
    9
  );

  // Borde

  noFill();

  stroke(30);
  strokeWeight(2);

  ellipse(
    centroX,
    centroY,
    25,
    25
  );

  noStroke();
}

// ==================================================
// NIEBLA DE GUERRA
// ==================================================

void actualizarDescubrimiento() {

  int centroCeldaX = int(jugadorX / tamanoCelda);
  int centroCeldaY = int(jugadorY / tamanoCelda);

  int rango = ceil(radioDescubrimiento / tamanoCelda);

  for (int x = centroCeldaX - rango;
       x <= centroCeldaX + rango;
       x++) {

    for (int y = centroCeldaY - rango;
         y <= centroCeldaY + rango;
         y++) {

      if (x < 0 || y < 0 ||
          x >= columnasNiebla ||
          y >= filasNiebla) {

        continue;
      }

      float mundoX = x * tamanoCelda + tamanoCelda/2;
      float mundoY = y * tamanoCelda + tamanoCelda/2;

      float distancia = dist(
        jugadorX,
        jugadorY,
        mundoX,
        mundoY
      );

      if (distancia <= radioDescubrimiento) {

        mapaDescubierto[x][y] = true;
      }
    }
  }
}

void dibujarNiebla() {

  noStroke();

  fill(0, 225);

  for (int x = 0; x < columnasNiebla; x++) {

    for (int y = 0; y < filasNiebla; y++) {

      if (!mapaDescubierto[x][y]) {

        rect(
          x * tamanoCelda - jugadorX,
          y * tamanoCelda - jugadorY,
          tamanoCelda + 1,
          tamanoCelda + 1
        );
      }
    }
  }
}

// ==================================================
// PUNTOS DE INTERES
// ==================================================

void dibujarPuntos() {

  textAlign(CENTER, CENTER);
  textSize(12);

  for (int i = 0; i < puntosX.length; i++) {

    float px = puntosX[i] - jugadorX;
    float py = puntosY[i] - jugadorY;

    fill(255, 220, 80);
    noStroke();

    ellipse(px, py, 14, 14);

    fill(255);

    text(
      nombresPuntos[i],
      px,
      py - 17
    );
  }
}

// ==================================================
// HUD
// ==================================================

void dibujarHUD() {

  noStroke();

  fill(20, 20, 30, 220);

  rect(0, 0, width, 65);

  fill(255);

  textAlign(LEFT, CENTER);

  textSize(18);

  text(
    "DIA " + diaActual,
    25,
    25
  );

  textSize(14);

  text(
    "8 HORAS",
    25,
    47
  );

  textAlign(RIGHT, CENTER);

  text(
    "WASD: Moverse | ESC: Pausar | M: Colisiones",
    width - 25,
    47
  );

  text(
    "X: " + int(jugadorX) + "   Y: " + int(jugadorY),
    width - 25,
    25
  );
}

// ==================================================
// DEPURACION DE COLISIONES
// ==================================================

void dibujarMascaraDepuracion() {

  pushMatrix();

  translate(width/2, height/2);

  scale(zoomActual);

  tint(255, 140);

  image(
    colisiones,
    -jugadorX,
    -jugadorY
  );

  noTint();

  popMatrix();

  fill(0, 210);

  noStroke();

  rect(15, 80, 280, 100, 8);

  int px = constrain(round(jugadorX), 0, colisiones.width - 1);
  int py = constrain(round(jugadorY), 0, colisiones.height - 1);

  color c = colisiones.pixels[
    py * colisiones.width + px
  ];

  fill(255);

  textAlign(LEFT, CENTER);
  textSize(13);

  text(
    "Jugador: " + int(jugadorX) + ", " + int(jugadorY),
    25,
    100
  );

  text(
    "Zona verde: " + esZonaVerde(jugadorX, jugadorY),
    25,
    120
  );

  text(
    "RGB: " + int(red(c)) + ", " +
    int(green(c)) + ", " + int(blue(c)),
    25,
    140
  );

  text(
    "Pulsa M para ocultar",
    25,
    160
  );
}

// ==================================================
// DIALOGO
// ==================================================

void dibujarDialogo() {

  noStroke();

  fill(0, 220);

  rect(
    0,
    height - 150,
    width,
    150
  );

  fill(255);

  textAlign(LEFT, CENTER);

  textSize(20);

  text(
    "Un compañero quiere hablar contigo...",
    40,
    height - 100
  );

  textSize(14);

  text(
    "Presiona ENTER para continuar.",
    40,
    height - 60
  );
}

// ==================================================
// MINIJUEGO
// ==================================================

void dibujarMinijuego() {

  background(35, 45, 60);

  fill(255);

  textAlign(CENTER, CENTER);

  textSize(30);

  text(
    "MINIJUEGO",
    width/2,
    height/2 - 30
  );

  textSize(16);

  text(
    "Esta pantalla se desarrollara posteriormente.",
    width/2,
    height/2 + 15
  );

  text(
    "Presiona ESC para pausar.",
    width/2,
    height/2 + 50
  );
}

// ==================================================
// PAUSA
// ==================================================

void dibujarPausa() {

  noStroke();

  fill(0, 190);

  rect(
    0,
    0,
    width,
    height
  );

  fill(255);

  textAlign(CENTER, CENTER);

  textSize(38);

  text(
    "PAUSA",
    width/2,
    190
  );

  dibujarBoton(
    "CONTINUAR",
    width/2 - 115,
    250,
    230,
    45
  );

  dibujarBoton(
    "VOLVER AL MENU",
    width/2 - 115,
    310,
    230,
    45
  );
}

// ==================================================
// FINAL
// ==================================================

void dibujarFinal() {

  background(25, 30, 40);

  fill(255);

  textAlign(CENTER, CENTER);

  textSize(38);

  text(
    "FIN DE LA PARTIDA",
    width/2,
    height/2 - 30
  );

  textSize(18);

  text(
    "Gracias por jugar Supervivencia Digital",
    width/2,
    height/2 + 25
  );

  dibujarBoton(
    "VOLVER AL MENU",
    width/2 - 115,
    height/2 + 80,
    230,
    45
  );
}

// ==================================================
// MOUSE
// ==================================================

void mousePressed() {

  if (!recursosListos) {
    return;
  }

  if (estadoActual == MENU) {

    if (mouseX >= 55 && mouseX <= 285) {

      if (mouseY >= 230 && mouseY <= 278) {

        iniciarCinematica();
      }
    }

    return;
  }

  if (estadoActual == PAUSA) {

    if (mouseX >= width/2 - 115 &&
        mouseX <= width/2 + 115) {

      if (mouseY >= 250 && mouseY <= 295) {

        estadoActual = EXPLORACION;
        return;
      }

      if (mouseY >= 310 && mouseY <= 355) {

        estadoActual = MENU;
        return;
      }
    }
  }

  if (estadoActual == FINAL) {

    if (mouseY >= height/2 + 80 &&
        mouseY <= height/2 + 125) {

      estadoActual = MENU;
    }
  }
}

// ==================================================
// TECLADO
// ==================================================

void keyPressed() {

  if (key == ESC) {

    key = 0;

    if (estadoActual == EXPLORACION ||
        estadoActual == DIALOGO ||
        estadoActual == MINIJUEGO) {

      estadoActual = PAUSA;

      // Evitar que el jugador siga moviendose en pausa.

      detenerControles();

    } else if (estadoActual == PAUSA) {

      estadoActual = EXPLORACION;
    }

    return;
  }

  if (key == 'w' || key == 'W') teclaW = true;
  if (key == 'a' || key == 'A') teclaA = true;
  if (key == 's' || key == 'S') teclaS = true;
  if (key == 'd' || key == 'D') teclaD = true;

  if (key == 'm' || key == 'M') {

    mostrarColisiones = !mostrarColisiones;
  }

  if (estadoActual == DIALOGO && key == ENTER) {

    estadoActual = EXPLORACION;
  }
}

// ==================================================
// SOLTAR TECLAS
// ==================================================

void keyReleased() {

  if (key == 'w' || key == 'W') teclaW = false;
  if (key == 'a' || key == 'A') teclaA = false;
  if (key == 's' || key == 'S') teclaS = false;
  if (key == 'd' || key == 'D') teclaD = false;
}

// ==================================================
// DETENER CONTROLES
// ==================================================

void detenerControles() {

  teclaW = false;
  teclaA = false;
  teclaS = false;
  teclaD = false;

  velocidad = 0;

  moviendo = false;
}
